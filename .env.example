# ---- Supabase (base de dados das reservas) ----
# Encontra estes valores em: Supabase > Project Settings > API
SUPABASE_URL=https://o-teu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=a-tua-service-role-key

# ---- Resend (envio de email) ----
# Cria a chave em: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Email que recebe as notificações de "já comprei"
NOTIFICATION_EMAIL=luciaefrancisco2025@gmail.com

# ---- Página de administração ----
# Password que só a Lúcia e o Francisco conhecem (para ver quem reservou)
ADMIN_PASSWORD=escolhe-uma-password-forte
